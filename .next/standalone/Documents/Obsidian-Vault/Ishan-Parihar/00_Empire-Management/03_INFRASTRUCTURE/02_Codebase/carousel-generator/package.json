{
  "name": "carousel-generator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "render": "ts-node --project tsconfig.render.json scripts/render-carousel.ts",
    "render:watch": "nodemon --exec 'npm run render' --watch data/current-carousel.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --testMatch='**/*.spec.ts'",
    "test:e2e:watch": "jest --watch --testMatch='**/*.spec.ts'",
    "test:e2e:debug": "jest --testMatch='**/*.spec.ts' --no-cache --verbose"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^10.0.0",
    "clsx": "^2.1.0",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.0",
    "jszip": "^3.10.0",
    "konva": "^9.3.0",
    "lucide-react": "^0.563.0",
    "next": "^16.1.4",
    "puppeteer": "^24.36.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-konva": "^19.2.1",
    "tailwind-merge": "^3.4.0",
    "use-image": "^1.1.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/yargs": "^17.0.35",
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.3"
  },
  "build": "next build"
}
